# Copy to .env and fill in. .env is git-ignored; never commit real passwords.

# --- Power BI destination ------------------------------------------------------
# Needs SELECT, INSERT, DELETE on the two tables below.
POWERBI_DB_HOST=13.126.54.249
POWERBI_DB_PORT=3306
POWERBI_DB_NAME=powerbidb
POWERBI_DB_USER=<powerbi-user>
POWERBI_DB_PASSWORD=<powerbi-password>
# Optional: path to a CA certificate to require TLS to the Power BI server.
# POWERBI_DB_SSL_CA=

# --- Markets: Sellerboard marketplace -> Power BI table --------------------------
# Defaults shown; uncomment to change. Another market (e.g. MX) needs MX_MARKETPLACE + MX_POWERBI_TABLE.
# SALES_MARKETS=US,CA
# US_MARKETPLACE=Amazon.com
# US_POWERBI_TABLE=combined_transposed_file_US
# CA_MARKETPLACE=Amazon.ca
# CA_POWERBI_TABLE=combined_transposed_file_CA

# --- Sellerboard ------------------------------------------------------------------
SELLERBOARD_ACCOUNT=premiumcarproduct@gmail.com
# Used by `run.py --login --terminal` and automatically when the saved session has expired
# (one attempt; after a refused attempt, scheduled runs wait 24 hours).
SELLERBOARD_LOGIN_EMAIL=<sellerboard-email>
SELLERBOARD_LOGIN_PASSWORD=<sellerboard-password>
# This project's own Sellerboard session (saved by `run.py --login`); relative = from the project folder.
SELLERBOARD_SESSION_FILE=data/browser/session.json

# --- Folders and logging ------------------------------------------------------------
# SELLERBOARD_DATA_DIR=data
# SELLERBOARD_LOG_DIR=logs
LOG_LEVEL=INFO
